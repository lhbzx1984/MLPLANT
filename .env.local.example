# Supabase 项目配置 (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# service_role 密钥, 仅服务端使用, 切勿泄露到客户端
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# 可选: JupyterLab 会话开通服务 (Webhook)
# 配置后, 学生开启实验时后端会 POST 该地址, 由其负责在云端 GPU 服务器上
# 启动 JupyterLab 容器并返回访问地址, 详见 README「JupyterLab 与 GPU 接入」
PROVISION_WEBHOOK_URL=
# 未配置 webhook 时, 学生会话使用的默认 JupyterLab 地址
NEXT_PUBLIC_DEFAULT_JUPYTER_URL=

# Jupyter 内核执行环境 (用于真实运行学生代码并比对输出)
# 填一个 Jupyter Server 地址与 token, 如 http://<GPU服务器IP>:8888
JUPYTER_EXECUTE_URL=
JUPYTER_EXECUTE_TOKEN=
# Agnes AI 图像生成 (平台视觉资产生成: node scripts/gen-assets.mjs)
AGNES_API_KEY=

# GPU 机器池: 平台与 spawner 的共享秘钥(自己随机生成, 两边一致)
SPAWNER_SECRET=
# 定时回收接口 /api/cron/reap 的调用秘钥
CRON_SECRET=
